function transformToUpperCase(executionContext) {
    var formContext = executionContext.getFormContext(); // Get form context
    var fieldName = "aglcm003_libelle"; // Replace with your column logical name

    var fieldValue = formContext.getAttribute(fieldName).getValue();

    if (fieldValue) {
        var upperCaseValue = fieldValue.toUpperCase();
        formContext.getAttribute(fieldName).setValue(upperCaseValue);
    }
}
