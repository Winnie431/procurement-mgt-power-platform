function addArticleLookupFilter(formContext, allowedGuids) {
    // Construire un filtre en utilisant les GUID autorisés
    const fetchXmlFilter = `
        <filter type="or">
            ${allowedGuids.map(guid => `<condition attribute="aglcm003_zulaa_articleid" operator="eq" value="${guid}" />`).join("")}
        </filter>
    `;

    // Appliquer le filtre FetchXML au champ lookup
    formContext.getControl("aglcm003_articleid").addCustomFilter(fetchXmlFilter, "aglcm003_zulaa_article");
}
