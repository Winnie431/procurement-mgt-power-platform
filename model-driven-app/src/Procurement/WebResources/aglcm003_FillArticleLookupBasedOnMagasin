function onFormLoad(executionContext) {
    const formContext = executionContext.getFormContext();

    // Check if the Magasin field is already populated
    const magasinLookup = formContext.getAttribute("aglcm003_magasinid").getValue();

    if (magasinLookup && magasinLookup[0]) {
        filterArticlesByMagasin(formContext, magasinLookup[0].id);
    }
}

