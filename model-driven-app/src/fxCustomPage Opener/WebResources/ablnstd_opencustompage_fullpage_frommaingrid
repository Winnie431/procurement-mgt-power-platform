function openCustomPage(executionContext,selectedItemIds, customPageName)
{
    const gridContext = executionContext;
    const pageInput = {
        pageType: "custom",
        name: customPageName,
        entityName: gridContext.getEntityName(),
        recordId: selectedItemIds
    };
    const navigationOptions = {
        target: 1
    };

    Xrm.Navigation.navigateTo(pageInput, navigationOptions)
        .then()
        .catch(
            function (error) {
                console.log(error.message)
            }
        ); 
   
    

};


